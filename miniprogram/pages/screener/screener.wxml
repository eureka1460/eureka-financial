<view class="page">
  <!-- 已添加条件 -->
  <view class="card">
    <view class="flex justify-between items-center" style="margin-bottom: 16rpx;">
      <text class="text-md font-bold">筛选条件</text>
      <view class="tag {{logic === 'AND' ? 'tag-accent' : 'tag-neutral'}}" bindtap="onToggleLogic">
        {{logic === 'AND' ? 'AND（全部满足）' : 'OR（任一满足）'}}
      </view>
    </view>

    <view wx:if="{{conditions.length > 0}}" class="cond-list">
      <filter-condition
        wx:for="{{conditions}}"
        wx:key="index"
        condition="{{item}}"
        index="{{index}}"
        metricLabel="{{item._label}}"
        bind:remove="onRemoveCondition"
      />
    </view>
    <view wx:else class="text-sm text-muted" style="padding: 20rpx 0; text-align: center;">
      添加至少一个筛选条件
    </view>

    <view class="flex gap-sm" style="margin-top: 16rpx;">
      <text class="text-xs text-secondary">报表类型：</text>
      <view wx:for="{{['annual','q1','semi_annual','q3']}}" wx:key="*this" wx:for-item="rt"
        class="tag {{reportType === rt ? 'tag-accent' : 'tag-neutral'}}" data-type="{{rt}}" bindtap="onPickReportType">
        {{rt === 'annual' ? '年报' : rt === 'q1' ? '一季报' : rt === 'semi_annual' ? '中报' : '三季报'}}</view>
    </view>

    <button class="btn btn-primary" style="width: 100%; margin-top: 20rpx;" bindtap="onSearch">开始筛选</button>
  </view>

  <!-- 添加条件表单 -->
  <view class="card">
    <text class="text-sm font-bold" style="margin-bottom: 16rpx; display: block;">添加条件</text>

    <!-- 指标 -->
    <view class="form-label text-xs text-secondary" bindtap="onToggleMetricList">选择指标：{{builderMetricName || '点击选择'}} ▼</view>
    <view wx:if="{{showMetricList}}" class="metric-list">
      <view wx:for="{{indicators}}" wx:key="field"
        class="metric-opt {{builderMetric === item.field ? 'active' : ''}}"
        data-idx="{{index}}" bindtap="onPickMetric">
        <text class="text-sm">{{item.chinese_name}}</text>
        <text class="text-xs text-muted">{{item.unit}}</text>
      </view>
    </view>

    <!-- 运算符 -->
    <view class="form-label text-xs text-secondary" style="margin-top: 16rpx;">运算符</view>
    <view class="flex gap-sm" style="margin-top: 8rpx;">
      <view wx:for="{{['>=', '<=', '>', '<', '==']}}" wx:key="*this" wx:for-item="op"
        class="tag {{builderOperator === op ? 'tag-accent' : 'tag-neutral'}}" data-op="{{op}}" bindtap="onPickOperator">
        {{op === '>=' ? '≥' : op === '<=' ? '≤' : op === '==' ? '=' : op}}</view>
    </view>

    <!-- 阈值 -->
    <view class="form-label text-xs text-secondary" style="margin-top: 16rpx;">阈值<text wx:if="{{builderUnit}}">（{{builderUnit}}）</text></view>
    <input class="value-input text-sm" type="digit" placeholder="{{builderUnit === '%' ? '如 0.15 = 15%' : builderUnit === '倍' ? '如 1.5' : '输入数值'}}" value="{{builderValue}}" bindinput="onValueInput" />

    <!-- 连续年数 -->
    <view class="form-label text-xs text-secondary" style="margin-top: 16rpx;">连续满足年数：{{builderYears}}</view>
    <slider min="1" max="5" value="{{builderYears}}" bindchange="onYearsChange" show-value activeColor="#3B82F6" block-size="16" />

    <button class="btn btn-outline" style="width: 100%; margin-top: 20rpx;" bindtap="onAddCondition">+ 确认添加条件</button>
  </view>

  <!-- 结果 -->
  <view wx:if="{{loading}}" class="loading-text">筛选中...</view>
  <view wx:elif="{{searched}}">
    <view class="result-header">
      <text class="text-sm text-secondary">筛选出 <text class="text-accent font-bold">{{total}}</text> 只股票</text>
    </view>
    <view wx:if="{{results.length === 0}}" class="empty-state">
      <text class="icon">🔍</text>
      <text class="text">没有符合条件的股票</text>
    </view>
    <stock-card wx:for="{{results}}" wx:key="symbol" stock="{{item}}" bind:tap="onStockTap" />
  </view>

  <view wx:if="{{error}}" class="empty-state">
    <text class="icon">⚠️</text>
    <text class="text">{{error}}</text>
  </view>
</view>
