.page {
  min-height: 100vh;
  background: var(--color-surface);
  padding-bottom: var(--spacing-xl);
}

/* ── 股票头部 ─────────────────────────── */
.stock-header {
  margin-top: var(--spacing-md);
}

/* ── 成长能力 ─────────────────────────── */
.growth-item {
  background: var(--color-surface);
  border-radius: var(--radius-sm);
  padding: var(--spacing-md);
  text-align: center;
}
.growth-item .text-xs {
  display: block;
  margin-bottom: 4rpx;
}

/* ── 快照网格 ───────────────────────── */
.snapshot-grid {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-md);
}
.snap-item {
  width: calc(50% - var(--spacing-md) / 2);
  background: var(--color-surface);
  border-radius: var(--radius-sm);
  padding: var(--spacing-md);
}
.snap-item .text-xs {
  display: block;
  margin-bottom: 4rpx;
}

/* ── 财务历史 ───────────────────────── */
.history-item {
  padding: var(--spacing-md) 0;
  border-bottom: 1rpx solid var(--color-divider);
}
.history-item:last-child {
  border-bottom: none;
}
.history-metric {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  min-width: 100rpx;
}
