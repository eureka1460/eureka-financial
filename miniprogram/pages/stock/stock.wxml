<view class="page">
  <view wx:if="{{loading}}" class="loading-text">加载中...</view>
  <view wx:elif="{{error}}" class="empty-state">
    <text class="text">⚠️ {{error}}</text>
    <button class="btn btn-outline" style="margin-top:24rpx" bindtap="onRetry">重试</button>
  </view>
  <block wx:else>
    <view class="header card">
      <view class="flex justify-between items-center">
        <view><text class="text-2xl font-bold">{{stock.name}}</text><text class="text-sm text-secondary" style="margin-left:12rpx">{{stock.symbol}}</text></view>
        <text class="tag tag-neutral">{{marketLabel}}</text>
      </view>
      <view class="text-xs text-muted" style="margin-top:4rpx">{{stock.industry || '行业未知'}}</view>
    </view>
    <view class="card">
      <text class="text-md font-bold" style="margin-bottom:16rpx;display:block">财务数据对比</text>
      <scroll-view scroll-x class="table-scroll">
        <view class="table">
          <view class="table-row table-header">
            <view class="col-label">指标</view>
            <view class="col-val" wx:for="{{periods}}" wx:key="key">{{item.label}}</view>
          </view>
          <view class="table-row" wx:for="{{rows}}" wx:key="field" bindtap="onTapMetric" data-field="{{item.field}}" data-name="{{item.name}}">
            <view class="col-label"><text class="text-sm">{{item.name}}</text><text class="help-q" catchtap="onHelpTap" data-name="{{item.name}}">?</text></view>
            <view class="col-val" wx:for="{{item.vals}}" wx:key="idx" wx:for-item="v"><text class="text-sm font-medium {{v.cls || ''}}">{{v.text || '--'}}</text></view>
          </view>
        </view>
      </scroll-view>
    </view>
    <view wx:if="{{chartMetricName}}" class="card">
      <view class="flex justify-between items-center" style="margin-bottom:8rpx">
        <text class="text-md font-bold">{{chartMetricName}}</text>
        <view class="flex items-center gap-sm">
          <view class="tag-pill {{chartPeriod === 'annual' ? 'pill-on' : ''}}" bindtap="onToggleChartPeriod">年报</view>
          <view class="tag-pill {{chartPeriod === 'quarterly' ? 'pill-on' : ''}}" bindtap="onToggleChartPeriod">季报</view>
          <text class="text-accent" style="margin-left:8rpx;font-size:28rpx" bindtap="onHideMetricChart">✕</text>
        </view>
      </view>
      <view class="ch-scroll">
        <view class="ch-body" style="min-width:{{chartMinW}}px;">
          <view class="ch-col" wx:for="{{chartBars}}" wx:key="year" style="min-width:{{chartColW}}px;" bindtap="onBarTap" data-idx="{{index}}">
            <view class="ch-bar-wrap">
              <view class="ch-bar {{item._neg ? 'ch-bar-red' : ''}}" style="height:{{item._h}}rpx; background:{{item._neg ? '#EF4444' : '#3B82F6'}};">
                <text wx:if="{{item._yTxt && item._h > 30}}" class="ch-yoy-on-bar {{item._yDn ? 'text-down' : 'text-up'}}">{{item._yTxt}}</text>
              </view>
            </view>
            <text class="ch-yr">{{item._lbl}}</text>
          </view>
          <view wx:if="{{tooltip}}" class="ch-tip" style="left:{{tooltip.x}}%;">{{tooltip.txt}}</view>
        </view>
      </view>
    </view>
    <view wx:if="{{helpText}}" class="help-overlay" bindtap="onCloseHelp">
      <view class="help-box" catchtap="">
        <text class="text-md font-bold" style="margin-bottom:16rpx;display:block">{{helpName}}</text>
        <text class="text-sm">{{helpText}}</text>
        <button class="btn btn-primary" style="margin-top:20rpx;width:100%" bindtap="onCloseHelp">知道了</button>
      </view>
    </view>
    <view class="card">
      <view class="flex justify-between items-center" bindtap="onToggleCharts">
        <text class="text-md font-bold">核心指标图表</text>
        <text class="text-sm text-secondary">{{showCharts ? '收起 ▲' : '展开 ▼'}}</text>
      </view>
      <view wx:if="{{showCharts}}">
        <history-chart title="营业总收入" chartData="{{chartRevenue}}" color="#3B82F6" />
        <history-chart title="归母净利润" chartData="{{chartProfit}}" color="#22C55E" />
        <history-chart title="ROE" chartData="{{chartROE}}" color="#8B5CF6" />
      </view>
    </view>
  </block>
</view>
