.stock-card {
  display: flex;
  align-items: center;
  padding: var(--spacing-lg);
  margin: var(--spacing-sm) var(--spacing-lg);
  background: var(--color-bg);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-card);
  gap: var(--spacing-md);
}

.stock-info {
  flex: 1;
  min-width: 0;
}

.stock-name {
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--color-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.stock-sub {
  margin-top: 4rpx;
}

.stock-metrics {
  display: flex;
  gap: var(--spacing-lg);
  flex-shrink: 0;
}

.metric-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 90rpx;
}

.metric-label {
  margin-bottom: 2rpx;
}

.metric-value {
  line-height: 1.2;
}

.stock-arrow {
  font-size: 40rpx;
  line-height: 1;
  flex-shrink: 0;
}
