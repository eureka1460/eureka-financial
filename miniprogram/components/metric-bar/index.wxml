<view class="metric-bar" bindtap="onTap">
  <view class="bar-header flex justify-between">
    <view class="flex items-center gap-xs">
      <text class="bar-label text-sm text-secondary">{{label}}</text>
      <indicator-help label="{{label}}" />
    </view>
    <text class="bar-value text-sm font-bold">{{showValue}}</text>
  </view>
  <view class="bar-track">
    <view
      class="bar-fill"
      style="width: {{barPercent}}%; background: {{color}};"
    ></view>
  </view>
</view>
