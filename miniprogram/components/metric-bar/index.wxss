.metric-bar {
  margin-bottom: var(--spacing-md);
}

.bar-header {
  margin-bottom: 6rpx;
}

.bar-label {
  line-height: 1.4;
}

.bar-value {
  line-height: 1.4;
  color: var(--color-text);
}

.bar-track {
  height: 10rpx;
  background: var(--color-divider);
  border-radius: var(--radius-full);
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  border-radius: var(--radius-full);
  transition: width 0.4s ease;
}
