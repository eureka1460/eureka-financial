<view class="ch" wx:if="{{list.length > 0}}">
  <view class="ch-scroll">
    <view class="ch-body">
      <view class="ch-col" wx:for="{{list}}" wx:key="year" wx:for-index="i">
        <!-- 同比标签（浮在柱子上方） -->
        <text class="ch-yoy {{item._yoyUp ? 'text-up' : ''}}{{item._yoyDn ? 'text-down' : ''}}{{item._yoyNone ? 'text-muted' : ''}}">
          {{item._yoy || '--'}}
        </text>

        <!-- 折线连接器 -->
        <view wx:if="{{item._lineDeg != null}}" class="ch-line"
          style="transform: rotate({{item._lineDeg}}deg); width: {{item._lineLen}}rpx;">
        </view>

        <!-- 柱子 -->
        <view class="ch-bar-wrap">
          <view class="ch-bar {{item._neg ? 'ch-bar-neg' : ''}}"
            style="height: {{item._h}}%; background: {{item._neg ? '#EF4444' : color}};">
          </view>
        </view>

        <!-- 绝对值 -->
        <text class="ch-val">{{item._val}}</text>

        <!-- 年份/季度 -->
        <text class="ch-yr">{{item.year}}</text>
      </view>
    </view>
  </view>
</view>
