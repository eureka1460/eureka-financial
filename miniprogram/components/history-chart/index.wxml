<view class="ch" wx:if="{{list.length > 0}}">
  <text class="ch-t">{{title}}</text>
  <view class="ch-scroll">
    <view class="ch-body">
      <view class="ch-col" wx:for="{{list}}" wx:key="year">
        <text class="ch-yoy {{item._yoyCls || ''}}">{{item._yoyTxt || ''}}</text>
        <view class="ch-bar-wrap">
          <view class="ch-bar {{item._neg ? 'ch-bar-neg' : ''}}" style="height: {{item._h}}%; background: {{item._neg ? '#EF4444' : item._color}};"></view>
        </view>
        <text class="ch-val">{{item._val}}</text>
        <text class="ch-yr">{{item._lbl}}</text>
      </view>
    </view>
  </view>
  <view class="ch-legend flex gap-md justify-center text-xs text-muted">
    <text>█ 绝对值</text>
    <text wx:if="{{hasLine}}">● 同比</text>
  </view>
</view>
