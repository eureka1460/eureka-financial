<view class="chart-card" wx:if="{{bars.length > 0}}">
  <text class="chart-title text-sm font-bold">{{title}}</text>

  <view class="chart-body {{hasNegative ? 'has-neg' : ''}}">
    <view class="bar-col" wx:for="{{bars}}" wx:key="year">
      <!-- 同比标签 -->
      <text wx:if="{{item.yoyText}}" class="yoy-tag {{item.yoyDown ? 'yoy-down' : 'yoy-up'}}">{{item.yoyText}}</text>
      <text wx:else class="yoy-tag yoy-none">--</text>

      <!-- 正数柱子上方的数值 -->
      <text wx:if="{{!item.isNeg}}" class="bar-val-top">{{item.displayVal}}</text>

      <!-- 柱子区域 -->
      <view class="bar-wrap">
        <view wx:if="{{!item.isNeg}}" class="bar bar-pos" style="height: {{item.height}}%; background: {{color}};"></view>
        <view wx:if="{{item.isNeg}}" class="bar bar-neg" style="height: {{item.height}}%; background: #EF4444;"></view>
      </view>

      <!-- 负数柱子下方的数值 -->
      <text wx:if="{{item.isNeg}}" class="bar-val-neg text-down">{{item.displayVal}}</text>

      <!-- 年份 -->
      <text class="bar-year">{{item.year}}</text>
    </view>
  </view>
</view>
