<view class="chart-card" wx:if="{{bars.length > 0}}">
  <text class="chart-title text-sm font-bold">{{title}}</text>

  <scroll-view scroll-x enhanced show-scrollbar class="chart-scroll">
    <view class="chart-body {{bars.length > 6 ? 'chart-wide' : ''}}">

      <view class="bar-col" wx:for="{{bars}}" wx:key="year">
        <!-- 同比折线点（在柱子上方） -->
        <text wx:if="{{item.yoyText}}" class="yoy-dot {{item.yoyDown ? 'text-down' : 'text-up'}}">{{item.yoyText}}</text>
        <text wx:else class="yoy-dot yoy-none">--</text>

        <!-- 柱子 -->
        <text wx:if="{{!item.isNeg}}" class="bar-val-top">{{item.displayVal}}</text>
        <view wx:if="{{!item.isNeg}}" class="bar-pos-box">
          <view class="bar bar-pos" style="height: {{item.height}}%; background: {{color}};"></view>
        </view>
        <view wx:if="{{item.isNeg}}" class="bar-neg-box">
          <view class="bar bar-neg" style="height: {{item.height}}%; background: #EF4444;"></view>
        </view>
        <text wx:if="{{item.isNeg}}" class="bar-val-neg text-down">{{item.displayVal}}</text>

        <text class="bar-year">{{item.year}}</text>
      </view>

    </view>
  </scroll-view>
</view>
