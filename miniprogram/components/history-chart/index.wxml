<view class="chart-card" wx:if="{{bars.length > 0}}">
  <text class="chart-title text-sm font-bold">{{title}}</text>
  <scroll-view scroll-x enhanced show-scrollbar class="chart-scroll">
    <canvas type="2d" id="chart-canvas" class="chart-canvas" style="width: {{chartWidth}}px;"></canvas>
  </scroll-view>
</view>
