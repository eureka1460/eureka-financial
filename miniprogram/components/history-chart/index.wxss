.ch {
  margin: 12rpx 0;
  padding: 12rpx;
  background: var(--color-surface);
  border-radius: var(--radius-sm);
}
.ch-t { font-size: 24rpx; font-weight: 600; margin-bottom: 6rpx; display: block; }
.ch-scroll { width: 100%; overflow-x: auto; -webkit-overflow-scrolling: touch; }
.ch-body { display: flex; align-items: flex-end; padding: 16rpx 0 0; min-width: 600px; height: 220rpx; }
.ch-col { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; min-width: 60px; }
.ch-yoy { font-size: 18rpx; font-weight: 700; white-space: nowrap; margin-bottom: 2rpx; }
.ch-bar-wrap { width: 60%; flex: 1; display: flex; flex-direction: column; justify-content: flex-end; }
.ch-bar { width: 100%; border-radius: 3rpx 3rpx 0 0; min-height: 3rpx; background: #3B82F6; }
.ch-bar-neg { border-radius: 0 0 3rpx 3rpx; background: #EF4444; }
.ch-val { font-size: 18rpx; color: var(--color-text-secondary); margin-top: 2rpx; white-space: nowrap; }
.ch-yr { font-size: 18rpx; color: var(--color-text-muted); margin-top: 2rpx; }
.ch-legend { margin-top: 8rpx; }
