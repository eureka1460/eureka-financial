.ch {
  margin: 12rpx 0;
  padding: 8rpx 12rpx;
  background: var(--color-surface);
  border-radius: var(--radius-sm);
}
.ch-scroll { width: 100%; overflow-x: auto; -webkit-overflow-scrolling: touch; }
.ch-body { display: flex; align-items: flex-end; padding: 20rpx 0 4rpx; min-width: 600px; height: 240rpx; }
.ch-col { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; min-width: 64px; position: relative; }
.ch-yoy { font-size: 20rpx; font-weight: 700; white-space: nowrap; margin-bottom: 4rpx; }
.ch-line { position: absolute; top: 28rpx; left: 50%; height: 2rpx; background: #F59E0B; z-index: 1; transform-origin: left center; }
.ch-bar-wrap { width: 55%; flex: 1; display: flex; flex-direction: column; justify-content: flex-end; }
.ch-bar { width: 100%; border-radius: 3rpx 3rpx 0 0; min-height: 3rpx; }
.ch-bar-neg { border-radius: 0 0 3rpx 3rpx; }
.ch-val { font-size: 20rpx; color: var(--color-text-secondary); margin-top: 4rpx; white-space: nowrap; }
.ch-yr { font-size: 20rpx; color: var(--color-text-muted); margin-top: 2rpx; }
