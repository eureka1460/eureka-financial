.chart-card {
  margin: var(--spacing-md) 0;
  padding: var(--spacing-md);
  background: var(--color-surface);
  border-radius: var(--radius-sm);
}

.chart-title {
  display: block;
  margin-bottom: var(--spacing-lg);
}

.chart-body {
  display: flex;
  justify-content: space-around;
  align-items: flex-end;
  height: 280rpx;
  padding-bottom: 20rpx;
}
.chart-body.has-neg {
  align-items: center;
  padding: 20rpx 0;
}

.bar-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  height: 100%;
  max-width: 120rpx;
}
.has-neg .bar-col {
  justify-content: center;
}

.yoy-tag {
  font-size: 18rpx;
  font-weight: 600;
  white-space: nowrap;
}
.yoy-up { color: #22C55E; }
.yoy-down { color: #EF4444; }
.yoy-none { color: var(--color-text-muted); }

.bar-val-top {
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
  margin-bottom: 4rpx;
  white-space: nowrap;
}
.bar-val-neg {
  font-size: var(--font-xs);
  margin-top: 4rpx;
  white-space: nowrap;
}

.bar-wrap {
  width: 60%;
  min-width: 40rpx;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.bar {
  width: 100%;
  border-radius: 4rpx 4rpx 0 0;
  min-height: 4rpx;
  transition: height 0.3s ease;
}
.bar-pos { border-radius: 4rpx 4rpx 0 0; }
.bar-neg { border-radius: 0 0 4rpx 4rpx; }

.bar-year {
  font-size: var(--font-xs);
  color: var(--color-text-muted);
  margin-top: 6rpx;
}
