.yoy-dot {
  font-size: 20rpx;
  font-weight: 700;
  flex-shrink: 0;
  line-height: 1;
  position: relative;
  padding-top: 4rpx;
}
.yoy-dot::before {
  content: '';
  display: block;
  width: 10rpx; height: 10rpx;
  border-radius: 50%;
  background: currentColor;
  margin: 0 auto 2rpx auto;
}

.chart-card {
  margin: var(--spacing-md) 0;
  padding: var(--spacing-md);
  background: var(--color-surface);
  border-radius: var(--radius-sm);
}

.chart-title {
  display: block;
  margin-bottom: var(--spacing-lg);
}

.chart-scroll { width: 100%; }

.chart-body {
  display: flex;
  justify-content: space-around;
  align-items: stretch;
  height: 260rpx;
}
.chart-wide { min-width: 1600rpx; }

.bar-col {
  flex: 1;
  min-width: 70rpx;
  max-width: 120rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
}

.yoy-tag {
  font-size: 16rpx;
  font-weight: 600;
  white-space: nowrap;
  flex-shrink: 0;
  line-height: 1;
}
.yoy-up { color: #22C55E; }
.yoy-down { color: #EF4444; }
.yoy-none { color: var(--color-text-muted); }

.bar-val-top {
  font-size: 18rpx;
  color: var(--color-text-secondary);
  flex-shrink: 0;
  white-space: nowrap;
}
.bar-val-neg {
  font-size: 18rpx;
  flex-shrink: 0;
  white-space: nowrap;
}

.bar-pos-box, .bar-neg-box {
  flex: 1;
  width: 55%;
  min-width: 32rpx;
  display: flex;
  flex-direction: column;
}
.bar-pos-box { justify-content: flex-end; }
.bar-neg-box { justify-content: flex-start; }

.bar {
  width: 100%;
  min-height: 4rpx;
  transition: height 0.3s ease;
}
.bar-pos { border-radius: 4rpx 4rpx 0 0; }
.bar-neg { border-radius: 0 0 4rpx 4rpx; }

.bar-year {
  font-size: 18rpx;
  color: var(--color-text-muted);
  flex-shrink: 0;
  line-height: 1;
}
