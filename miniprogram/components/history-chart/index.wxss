.chart-card {
  margin: var(--spacing-md) 0;
  padding: var(--spacing-md);
  background: var(--color-surface);
  border-radius: var(--radius-sm);
}

.chart-title {
  display: block;
  margin-bottom: var(--spacing-lg);
}

.chart-body {
  display: flex;
  justify-content: space-around;
  align-items: stretch;
  height: 300rpx;
}

.bar-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  max-width: 120rpx;
}

.yoy-tag {
  font-size: 18rpx;
  font-weight: 600;
  white-space: nowrap;
  flex-shrink: 0;
}
.yoy-up { color: #22C55E; }
.yoy-down { color: #EF4444; }
.yoy-none { color: var(--color-text-muted); }

.bar-val-top {
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
  flex-shrink: 0;
  white-space: nowrap;
}
.bar-val-neg {
  font-size: var(--font-xs);
  flex-shrink: 0;
  white-space: nowrap;
}

.bar-pos-box, .bar-neg-box {
  flex: 1;
  width: 60%;
  min-width: 40rpx;
  display: flex;
  flex-direction: column;
}
.bar-pos-box { justify-content: flex-end; }
.bar-neg-box { justify-content: flex-start; }

.bar {
  width: 100%;
  min-height: 4rpx;
  transition: height 0.3s ease;
}
.bar-pos { border-radius: 4rpx 4rpx 0 0; }
.bar-neg { border-radius: 0 0 4rpx 4rpx; }

.bar-year {
  font-size: var(--font-xs);
  color: var(--color-text-muted);
  flex-shrink: 0;
}
