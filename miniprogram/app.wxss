/* ═══════════════════════════════════════════════════════
   Eureka 财报研究 — 全局样式（极简白底风）
   ═══════════════════════════════════════════════════════ */

page {
  --color-bg: #FFFFFF;
  --color-surface: #F7F8FA;
  --color-text: #1A1A1A;
  --color-text-secondary: #6B7280;
  --color-text-muted: #9CA3AF;
  --color-accent: #3B82F6;
  --color-accent-light: #EFF6FF;
  --color-up: #22C55E;
  --color-down: #EF4444;
  --color-border: #E5E7EB;
  --color-divider: #F3F4F6;

  --radius-sm: 8rpx;
  --radius-md: 12rpx;
  --radius-lg: 16rpx;
  --radius-full: 9999rpx;

  --shadow-sm: 0 1rpx 4rpx rgba(0, 0, 0, 0.04);
  --shadow-card: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  --shadow-lg: 0 4rpx 24rpx rgba(0, 0, 0, 0.10);

  --font-xs: 22rpx;
  --font-sm: 26rpx;
  --font-base: 28rpx;
  --font-md: 30rpx;
  --font-lg: 34rpx;
  --font-xl: 40rpx;
  --font-2xl: 48rpx;

  --spacing-xs: 8rpx;
  --spacing-sm: 12rpx;
  --spacing-md: 16rpx;
  --spacing-lg: 24rpx;
  --spacing-xl: 32rpx;

  background-color: var(--color-surface);
  color: var(--color-text);
  font-size: var(--font-base);
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

/* ── 按钮重置 ──────────────────────────────────────────── */
button {
  background: initial;
}
button:focus { outline: 0; }
button::after { border: none; }

/* ── 通用卡片 ─────────────────────────────────────────── */
.card {
  background: var(--color-bg);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-card);
  padding: var(--spacing-lg);
  margin: var(--spacing-md) var(--spacing-lg);
}

/* ── 通用文本 ─────────────────────────────────────────── */
.text-xs  { font-size: var(--font-xs); }
.text-sm  { font-size: var(--font-sm); }
.text-base { font-size: var(--font-base); }
.text-lg  { font-size: var(--font-lg); }
.text-xl  { font-size: var(--font-xl); }
.text-2xl { font-size: var(--font-2xl); }

.text-secondary { color: var(--color-text-secondary); }
.text-muted     { color: var(--color-text-muted); }
.text-accent    { color: var(--color-accent); }
.text-up        { color: var(--color-up); }
.text-down      { color: var(--color-down); }

.font-bold   { font-weight: 700; }
.font-medium { font-weight: 500; }

/* ── 通用布局 ─────────────────────────────────────────── */
.flex { display: flex; }
.flex-col { display: flex; flex-direction: column; }
.flex-1 { flex: 1; }
.items-center { align-items: center; }
.justify-between { justify-content: space-between; }
.justify-center { justify-content: center; }
.gap-xs { gap: var(--spacing-xs); }
.gap-sm { gap: var(--spacing-sm); }
.gap-md { gap: var(--spacing-md); }

/* ── 标签/徽章 ─────────────────────────────────────────── */
.tag {
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: var(--radius-full);
  font-size: var(--font-xs);
  font-weight: 500;
  line-height: 1.4;
}
.tag-accent  { background: var(--color-accent-light); color: var(--color-accent); }
.tag-up      { background: #F0FDF4; color: #16A34A; }
.tag-down    { background: #FEF2F2; color: #DC2626; }
.tag-neutral { background: var(--color-surface); color: var(--color-text-secondary); }

/* ── 搜索栏 ────────────────────────────────────────────── */
.search-bar {
  display: flex;
  align-items: center;
  background: var(--color-surface);
  border-radius: var(--radius-full);
  padding: var(--spacing-sm) var(--spacing-lg);
  margin: var(--spacing-md) var(--spacing-lg);
  gap: var(--spacing-sm);
}
.search-bar input {
  flex: 1;
  border: none;
  background: transparent;
  font-size: var(--font-base);
  color: var(--color-text);
  outline: none;
}
.search-bar .icon {
  width: 36rpx;
  height: 36rpx;
  opacity: 0.4;
}

/* ── 分隔线 ────────────────────────────────────────────── */
.divider {
  height: 1rpx;
  background: var(--color-divider);
  margin: var(--spacing-md) 0;
}

/* ── 加载与空状态 ──────────────────────────────────────── */
.loading-text {
  text-align: center;
  padding: var(--spacing-xl) 0;
  color: var(--color-text-muted);
  font-size: var(--font-sm);
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx var(--spacing-lg);
  color: var(--color-text-muted);
}
.empty-state .icon {
  font-size: 80rpx;
  margin-bottom: var(--spacing-md);
}
.empty-state .text {
  font-size: var(--font-sm);
}

/* ── 按钮 ──────────────────────────────────────────────── */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-md);
  font-weight: 600;
  font-size: var(--font-base);
  padding: var(--spacing-sm) var(--spacing-lg);
  border: none;
}
.btn-primary {
  background: var(--color-accent);
  color: #FFFFFF;
}
.btn-outline {
  background: transparent;
  color: var(--color-accent);
  border: 2rpx solid var(--color-accent);
}
